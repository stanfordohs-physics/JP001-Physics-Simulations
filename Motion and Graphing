<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>JP001 | One-Dimensional Motion Graphs</title><style>
:root{font-family:system-ui,-apple-system,Arial,sans-serif;color:#383f46;background:#fff}*{box-sizing:border-box}body{margin:0 auto;max-width:1100px;padding:20px}header{border-bottom:3px solid #8c1515;text-align:center;margin-bottom:18px}h1{color:#8c1515;font-size:1.65rem;margin:6px}header p{color:#626b72;margin:8px 0 16px}.intro{background:#eef4f8;border-left:4px solid #016895;border-radius:10px;padding:12px 16px;margin-bottom:16px}.controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:14px 0}.controls button{border:1px solid #a9b8c5;background:#fff;padding:10px 16px;border-radius:9px;font-size:1rem;cursor:pointer}.controls button:focus-visible{outline:3px solid #016895}.controls button.primary{background:#016895;color:white}.readout{display:flex;gap:12px;flex-wrap:wrap;margin:14px 0}.metric{flex:1;min-width:135px;background:#f0ecf8;padding:12px;border-radius:10px}.metric b{display:block;color:#65458b}.track{border:1px solid #d5dce1;border-radius:12px;background:linear-gradient(#f7fbff,#e9f2f8);overflow:hidden}.track svg{display:block;width:100%;height:auto}.graphs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:15px}.panel{border:1px solid #d5dce1;border-radius:12px;overflow:hidden}.panel h2{margin:0;padding:10px 12px;font-size:1rem;background:#e7f2e9;color:#276749}.panel svg{width:100%;height:auto;display:block}.hint{font-size:.9rem;color:#59636b}.accel{background:#fff2da;border-left:4px solid #a66b19;padding:12px;border-radius:10px;margin-top:14px}kbd{border:1px solid #bbb;border-radius:4px;padding:1px 5px;background:#fff}@media(max-width:700px){.graphs{grid-template-columns:1fr}body{padding:12px}}
</style></head><body><header><h1>One-Dimensional Motion Explorer</h1><p>JP001 Inquiry Based Physics · Observe • Predict • Explain</p></header><div class="intro">Use the controls to change the rocket's acceleration. Watch how the motion and three graphs change together. Positive is to the right.</div>
<div class="controls"><button id="play" class="primary">▶ Start</button><button id="pause">⏸ Pause</button><button id="reset">↺ Reset</button><button id="left">◀ Accelerate left</button><button id="coast">No acceleration</button><button id="right">Accelerate right ▶</button></div>
<div class="readout"><div class="metric"><b>Time</b><span id="t">0.00 s</span></div><div class="metric"><b>Position</b><span id="x">0.00 m</span></div><div class="metric"><b>Velocity</b><span id="v">0.00 m/s</span></div><div class="metric"><b>Acceleration</b><span id="a">0.00 m/s²</span></div></div>
<div class="track"><svg viewBox="0 0 900 180" role="img" aria-label="Rocket moving horizontally along a numbered position axis"><defs><pattern id="ticks" width="45" height="14" patternUnits="userSpaceOnUse"><path d="M0 0V12" stroke="#8c9ca6"/></pattern></defs><path d="M30 122H870" stroke="#657b8b" stroke-width="2"/><path d="M30 122H870" stroke="url(#ticks)" stroke-width="14"/><g id="rocket" transform="translate(450 78)"><path d="M-28 0L-12 -15L18 -15L36 0L18 15L-12 15Z" fill="#8c1515" stroke="#5c0d0d" stroke-width="2"/><circle cx="8" cy="0" r="8" fill="#a9d7ee" stroke="#fff" stroke-width="2"/><path id="flame" d="M-28 -8L-46 0L-28 8Z" fill="#f5a623"/></g><text x="30" y="151" fill="#536777">−10 m</text><text x="450" y="151" text-anchor="middle" fill="#536777">0 m</text><text x="870" y="151" text-anchor="end" fill="#536777">+10 m</text><text x="450" y="174" text-anchor="middle" fill="#536777">Position along the track</text></svg></div>
<div class="accel"><strong>Acceleration:</strong> <span id="mode">0 m/s² (coasting)</span>. Keyboard: <kbd>←</kbd> accelerate left, <kbd>→</kbd> accelerate right, <kbd>↓</kbd> coast, <kbd>Space</kbd> play/pause.</div>
<div class="graphs"><div class="panel"><h2>Position vs. time</h2><svg id="gx" viewBox="0 0 320 250" role="img" aria-label="Position versus time graph"></svg></div><div class="panel"><h2>Velocity vs. time</h2><svg id="gv" viewBox="0 0 320 250" role="img" aria-label="Velocity versus time graph"></svg></div><div class="panel"><h2>Acceleration vs. time</h2><svg id="ga" viewBox="0 0 320 250" role="img" aria-label="Acceleration versus time graph"></svg></div></div><p class="hint">Graph windows show the latest 20 seconds. If the rocket reaches the edge of the track, it stops there. Reset to begin a new run.</p>
<script>
(()=>{'use strict';let x=0,v=0,a=0,t=0,playing=false,last=0,samples=[{t:0,x:0,v:0,a:0}],lastSample=0;const $=id=>document.getElementById(id);const fmt=(n,u)=>`${n.toFixed(2)} ${u}`;function setA(n){a=n;$('mode').textContent=`${n>0?'+':''}${n} m/s² ${n===0?'(coasting)':n>0?'(right)':'(left)'}`;update();}function reset(){playing=false;x=v=a=t=lastSample=0;samples=[{t:0,x:0,v:0,a:0}];$('mode').textContent='0 m/s² (coasting)';update();}function update(){ $('t').textContent=fmt(t,'s');$('x').textContent=fmt(x,'m');$('v').textContent=fmt(v,'m/s');$('a').textContent=fmt(a,'m/s²');$('rocket').setAttribute('transform',`translate(${450+42*x} 78)`);$('flame').setAttribute('opacity',a===0?'0.15':'1');draw('gx','x',-10,10,'Position (m)','#016895');draw('gv','v',-10,10,'Velocity (m/s)','#276749');draw('ga','a',-3,3,'Acceleration (m/s²)','#8c1515');}
function draw(id,key,min,max,label,color){let svg=$(id),ns='http://www.w3.org/2000/svg';while(svg.firstChild)svg.removeChild(svg.firstChild);function el(tag,attrs,text){let n=document.createElementNS(ns,tag);Object.entries(attrs).forEach(([k,v])=>n.setAttribute(k,v));if(text!==undefined)n.textContent=text;svg.appendChild(n);return n;}const L=47,R=307,T=18,B=210;for(let i=0;i<=4;i++){let yy=T+i*(B-T)/4;el('line',{x1:L,y1:yy,x2:R,y2:yy,stroke:'#e3e8ec'});el('text',{x:L-6,y:yy+4,'text-anchor':'end','font-size':11,fill:'#52616b'},(max-(max-min)*i/4).toFixed(1));}let start=Math.max(0,t-20),end=start+20;for(let i=0;i<=4;i++){let xx=L+i*(R-L)/4;el('line',{x1:xx,y1:T,x2:xx,y2:B,stroke:'#edf0f3'});el('text',{x:xx,y:B+16,'text-anchor':'middle','font-size':11,fill:'#52616b'},(start+5*i).toFixed(0));}el('line',{x1:L,y1:B,x2:R,y2:B,stroke:'#647582'});el('line',{x1:L,y1:T,x2:L,y2:B,stroke:'#647582'});let visible=samples.filter(s=>s.t>=start);visible.push({t,x,v,a});let pts=visible.map(s=>`${L+(s.t-start)/20*(R-L)},${T+(max-Math.max(min,Math.min(max,s[key])))/(max-min)*(B-T)}`).join(' ');if(pts)el('polyline',{points:pts,fill:'none',stroke:color,'stroke-width':2.7,'stroke-linejoin':'round'});el('text',{x:(L+R)/2,y:245,'text-anchor':'middle','font-size':12,fill:'#52616b'},'Time (s)');el('text',{x:L+5,y:12,'font-size':12,fill:color},label);}
function tick(now){if(!last)last=now;let dt=Math.min((now-last)/1000,.05);last=now;if(playing){let oldv=v;v+=a*dt;x+=(oldv+v)*dt/2;t+=dt;if(x>10||x< -10){x=Math.max(-10,Math.min(10,x));v=0;a=0;playing=false;$('mode').textContent='0 m/s² (track boundary reached)';}if(t-lastSample>=.07){samples.push({t,x,v,a});lastSample=t;if(samples.length>4000)samples.shift();}update();}requestAnimationFrame(tick);} $('play').onclick=()=>{playing=true;};$('pause').onclick=()=>{playing=false;};$('reset').onclick=reset;$('left').onclick=()=>setA(-2);$('right').onclick=()=>setA(2);$('coast').onclick=()=>setA(0);window.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','ArrowDown','Space'].includes(e.code)){e.preventDefault();if(e.code==='ArrowLeft')setA(-2);if(e.code==='ArrowRight')setA(2);if(e.code==='ArrowDown')setA(0);if(e.code==='Space')playing=!playing;}});update();requestAnimationFrame(tick);
})();
</script></body></html>
