<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Velocity Vectors A–F | JP001</title>
<style>
:root{font-family:Arial,Helvetica,sans-serif;color:#282828;background:#fff}*{box-sizing:border-box}body{margin:0;padding:18px}main{max-width:900px;margin:auto}h1{font-size:clamp(19px,3vw,26px);font-weight:600;margin:0 0 8px;color:#8c1515}p{margin:0 0 20px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px 28px}.panel{text-align:center}.letter{font-size:23px;font-family:Georgia,serif;margin-bottom:4px}.square{border:1.5px solid #9aa3ae;border-radius:7px;aspect-ratio:1;position:relative;background:white}.square svg{width:100%;height:100%;display:block;overflow:visible}.dot{fill:#fff;stroke:#333;stroke-width:1.3}.shaft{stroke:#119d2b;stroke-width:2.8;stroke-linecap:round}.tip{fill:#119d2b}footer{margin-top:18px;color:#666;font-size:12px;text-align:center}@media(max-width:550px){body{padding:12px}.grid{gap:16px 10px}.letter{font-size:19px}.shaft{stroke-width:3.3}}
</style>
</head>
<body><main><h1>Velocity vectors</h1><p>These are <span style="color:#148d25">velocity vectors</span> for a series of objects.</p><div class="grid" id="grid"></div><footer>JP001 · Inquiry-Based Physics · Continuous animation</footer></main>
<script>
'use strict';
// All six vector tails are fixed at the centers of their respective panels.
// The green arrows depict instantaneous velocity, not displacement.
const grid=document.getElementById('grid');
const letters=['A','B','C','D','E','F'];
const arrows=letters.map(letter=>{
 const panel=document.createElement('section');panel.className='panel';
 panel.innerHTML=`<div class="letter">${letter}</div><div class="square"><svg viewBox="0 0 200 200" role="img" aria-label="Velocity vector ${letter}"><line class="shaft" x1="100" y1="100" x2="100" y2="100"/><polygon class="tip" points="0,0 0,0 0,0"/><circle class="dot" cx="100" cy="100" r="2.7"/></svg></div>`;
 grid.appendChild(panel);
 return {shaft:panel.querySelector('line'),tip:panel.querySelector('polygon')};
});
function vector(i,t){
 switch(i){
  case 0: { // A: changing direction and changing magnitude
   const a=t*1.35+0.5, len=36+43*(0.5+0.5*Math.sin(t*1.8));
   return [len*Math.cos(a),len*Math.sin(a)];
  }
  case 1: return [76,76]; // B: constant velocity
  case 2: { // C: direction reverses, magnitude changes
   const a=2.35+Math.PI*(Math.sin(t*0.85)>0?0:1);
   const len=13+74*Math.pow(Math.abs(Math.sin(t*0.85)),0.8);
   return [len*Math.cos(a),len*Math.sin(a)];
  }
  case 3: { // D: fixed direction, changing speed
   const len=9+85*(0.5+0.5*Math.sin(t*1.1+0.7));
   return [len/Math.SQRT2,len/Math.SQRT2];
  }
  case 4: { // E: constant speed, changing direction
   const a=t*1.55+0.25,len=72;
   return [len*Math.cos(a),len*Math.sin(a)];
  }
  case 5: { // F: horizontal, changing magnitude
   const len=3+68*(0.5+0.5*Math.sin(t*1.4+1));
   return [len,0];
  }
 }
}
function drawVector(o,dx,dy){
 const x=100+dx,y=100+dy;
 o.shaft.setAttribute('x2',x.toFixed(2));o.shaft.setAttribute('y2',y.toFixed(2));
 const length=Math.hypot(dx,dy);
 if(length<5){o.tip.setAttribute('points','');return;}
 const ux=dx/length,uy=dy/length,back=9,side=4.6;
 const bx=x-back*ux,by=y-back*uy;
 o.tip.setAttribute('points',`${x},${y} ${bx-side*uy},${by+side*ux} ${bx+side*uy},${by-side*ux}`);
}
let start=null;
function animate(now){
 if(start===null)start=now;
 const t=(now-start)/1000;
 arrows.forEach((o,i)=>drawVector(o,...vector(i,t)));
 requestAnimationFrame(animate);
}
requestAnimationFrame(animate);
</script></body></html>
